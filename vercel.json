{
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/@google/genai/**",
        "node_modules/mammoth/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
